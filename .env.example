# Copy to .env and replace every value before deploying. Do not commit .env.
# Avoid ';' in MYSQL_PASSWORD (it is embedded in the connection string).
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_PASSWORD=change-me-app
MYSQL_DATABASE=notes
MYSQL_USER=notes

# Image name/tag to build and run; point at your registry to push, e.g. ghcr.io/you/bluestaq-notes-api:1.0.0
API_IMAGE=bluestaq-notes-api:latest
API_BIND_ADDRESS=0.0.0.0
API_PORT=8080

# Initial administrator, created or promoted at startup.
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=change-me-admin

MIGRATE_ON_STARTUP=true
SESSION_IDLE_TIMEOUT=08:00:00
# Set true only behind a trusted reverse proxy that terminates TLS.
FORWARDED_HEADERS_ENABLED=false
