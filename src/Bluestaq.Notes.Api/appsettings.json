{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Notes": ""
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Sessions": {
    "IdleTimeout": "08:00:00",
    "CookieName": "notes_session"
  },
  "Admin": {
    "BootstrapUsername": "",
    "BootstrapPassword": ""
  },
  "AdminAudit": {
    "LogFilePath": "logs/admin-audit-.log",
    "RetainedFileCount": 90
  },
  "Export": {
    "MaxNotes": 10000
  },
  "Import": {
    "MaxNotes": 10000
  },
  "Digest": {
    "TimeZone": "America/New_York",
    "SendWindow": "01:00:00",
    "PollInterval": "00:01:00",
    "From": "notes@bluestaq.local",
    "Smtp": {
      "Host": "",
      "Port": 25,
      "Security": "Auto",
      "Username": "",
      "Password": ""
    }
  },
  "RateLimiting": {
    "Auth": {
      "PermitLimit": 10,
      "Window": "00:01:00"
    }
  }
}
