@host = http://localhost:5188

### Register
POST {{host}}/api/auth/register
Content-Type: application/json

{ "username": "alice", "password": "password123" }

### Login (copy "token" from the response into @token below; browsers use the session cookie instead)
POST {{host}}/api/auth/login
Content-Type: application/json

{ "username": "alice", "password": "password123" }

###
@token = paste-token-here

### Current user
GET {{host}}/api/auth/me
Authorization: Bearer {{token}}

### List notes
GET {{host}}/api/notes?page=1&pageSize=20
Authorization: Bearer {{token}}

### Create note
POST {{host}}/api/notes
Authorization: Bearer {{token}}
Content-Type: application/json

{ "title": "Groceries", "content": "Milk, eggs" }

### Get note
GET {{host}}/api/notes/1
Authorization: Bearer {{token}}

### Update note
PUT {{host}}/api/notes/1
Authorization: Bearer {{token}}
Content-Type: application/json

{ "title": "Groceries", "content": "Milk, eggs, bread" }

### Delete note
DELETE {{host}}/api/notes/1
Authorization: Bearer {{token}}

### Export notes by ID
POST {{host}}/api/notes/export
Authorization: Bearer {{token}}
Content-Type: application/json

{ "noteIds": [1, 2, 3] }

### Export all of a user's notes you can read
POST {{host}}/api/notes/export
Authorization: Bearer {{token}}
Content-Type: application/json

{ "userId": 1 }

### Export notes created in a date range, as CSV
POST {{host}}/api/notes/export
Authorization: Bearer {{token}}
Content-Type: application/json

{ "from": "2026-01-01T00:00:00Z", "to": "2026-12-31T23:59:59Z", "format": "csv" }

### Make a note public
PUT {{host}}/api/notes/1/visibility
Authorization: Bearer {{token}}
Content-Type: application/json

{ "visibility": "public" }

### Share a note with a user
POST {{host}}/api/notes/1/shares
Authorization: Bearer {{token}}
Content-Type: application/json

{ "username": "bob" }

### Make a user an editor (or "Read" to downgrade)
POST {{host}}/api/notes/1/shares
Authorization: Bearer {{token}}
Content-Type: application/json

{ "username": "bob", "permission": "Edit" }

### Editor: ask the owner to share a note
POST {{host}}/api/notes/1/share-requests
Authorization: Bearer {{token}}
Content-Type: application/json

{ "username": "carol", "permission": "Read" }

### A note's share requests
GET {{host}}/api/notes/1/share-requests?status=Pending
Authorization: Bearer {{token}}

### Pending share requests on all my notes
GET {{host}}/api/notes/share-requests
Authorization: Bearer {{token}}

### Approve a share request
POST {{host}}/api/notes/1/share-requests/1/approve
Authorization: Bearer {{token}}

### Reject a share request
POST {{host}}/api/notes/1/share-requests/1/reject
Authorization: Bearer {{token}}

### See who a note is shared with
GET {{host}}/api/notes/1/sharing
Authorization: Bearer {{token}}

### Revoke a user's access
DELETE {{host}}/api/notes/1/shares/bob
Authorization: Bearer {{token}}

### Notes shared with me (or public)
GET {{host}}/api/notes/shared
Authorization: Bearer {{token}}

### Import notes (an export document, or just its "notes")
POST {{host}}/api/notes/import
Authorization: Bearer {{token}}
Content-Type: application/json

{ "notes": [ { "id": 7, "title": "Imported", "content": "From another instance", "visibility": "private" } ] }

### Digest opt-ins and next send time
GET {{host}}/api/digest
Authorization: Bearer {{token}}

### Opt in to both digest sections
PUT {{host}}/api/digest
Authorization: Bearer {{token}}
Content-Type: application/json

{ "sharedNotes": true, "publicNotes": true }

### Preview tonight's digest
GET {{host}}/api/digest/preview
Authorization: Bearer {{token}}

### Admin: list users
GET {{host}}/api/admin/users
Authorization: Bearer {{token}}

### Admin: change a user's role
PUT {{host}}/api/admin/users/2/role
Authorization: Bearer {{token}}
Content-Type: application/json

{ "role": "Administrator" }

### Admin: all notes (optionally for one owner)
GET {{host}}/api/admin/notes?userId=2
Authorization: Bearer {{token}}

### Admin: audit log
GET {{host}}/api/admin/audit-log
Authorization: Bearer {{token}}

### Health
GET {{host}}/health

### Logout
POST {{host}}/api/auth/logout
Authorization: Bearer {{token}}
